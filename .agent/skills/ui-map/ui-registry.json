{
  "project": "Vibe Metronome",
  "registry_status": "MANUALLY_CURATED",
  "registry": [
    {
      "area": "Main_Header (顶部工具栏)",
      "container": "styles['header-buttons']",
      "path": "src/App.tsx",
      "entities": [
        {
          "id": "btn_theme_cycle",
          "name": "主题轮播按钮",
          "icon": "Palette",
          "path": "src/App.tsx",
          "logic": "cycleTheme()",
          "desc": "右上角图标，顺序循环切换主题"
        },
        {
          "id": "sel_theme_picker",
          "name": "主题选择列表",
          "icon": "Palette",
          "path": "src/App.tsx",
          "desc": "基于 Select 组件的主题下拉，呼出所有主题文字列表"
        },
        {
          "id": "sel_lang_picker",
          "name": "语言切换器",
          "icon": "Globe",
          "path": "src/App.tsx",
          "desc": "基于 Select 组件的语言下拉，切换 9 种语言"
        },
        {
          "id": "btn_help_open",
          "name": "帮助中心入口",
          "icon": "HelpCircle",
          "path": "src/App.tsx",
          "action": "setIsHelpOpen(true)"
        }
      ]
    },
    {
      "area": "Main_BPM_Display (速度显示区)",
      "container": "styles['bpm-display']",
      "path": "src/components/BpmDisplay/index.tsx",
      "entities": [
        {
          "id": "lbl_bpm",
          "name": "BPM 竖排标签",
          "selector": ".bpm-display__label",
          "desc": "主读数左侧的 B/P/M 字母标签"
        },
        {
          "id": "dsp_bpm_value",
          "name": "BPM 核心读数",
          "selector": ".bpm-display__value-wrapper",
          "desc": "主数字显示，点击进入编辑态 (inp_bpm_input)"
        },
        {
          "id": "inp_bpm_input",
          "name": "BPM 编辑框",
          "selector": ".bpm-display__input",
          "desc": "激活态下的数字输入文本框"
        },
        {
          "id": "whl_bpm_wheel",
          "name": "BPM 物理滚轮",
          "selector": ".bpm-display__wheel",
          "desc": "数字右侧垂直条，拖拽调节"
        },
        {
          "id": "btn_bpm_step_p5",
          "name": "步进 +5",
          "icon": "ChevronsUp",
          "logic": "handleBtnClick(e, 5)"
        },
        {
          "id": "btn_bpm_step_p1",
          "name": "步进 +1",
          "icon": "ChevronUp",
          "logic": "handleBtnClick(e, 1)"
        },
        {
          "id": "btn_bpm_step_m1",
          "name": "步进 -1",
          "icon": "ChevronDown",
          "logic": "handleBtnClick(e, -1)"
        },
        {
          "id": "btn_bpm_step_m5",
          "name": "步进 -5",
          "icon": "ChevronsDown",
          "logic": "handleBtnClick(e, -5)"
        }
      ]
    },
    {
      "area": "Main_BPM_History (速度历史与测速)",
