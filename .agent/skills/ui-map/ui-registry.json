      "path": "src/components/BpmHistoryBar/index.tsx",
      "entities": [
        {
          "id": "lst_bpm_history",
          "name": "历史速度列表容器",
          "selector": ".history-bar__list",
          "desc": "横向滚动容器，承载历史 BPM 胶囊与空状态"
        },
        {
          "id": "btn_bpm_save",
          "name": "保存当前速度",
          "icon": "Star",
