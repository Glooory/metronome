        },
        {
          "id": "btn_vis_shift_l",
          "name": "节奏左偏 (Shift-)",
          "icon": "Minus"
        },
        {
          "id": "dsp_vis_shift_value",
          "name": "偏移数值读数",
          "selector": ".visualizer__value",
          "desc": "显示当前 shift 值；非 0 时进入激活态高亮"
        },
        {
          "id": "btn_vis_shift_r",
          "name": "节奏右偏 (Shift+)",
          "icon": "Plus"
        },
        {
          "id": "btn_vis_reset",
          "name": "重置偏移",
          "icon": "RefreshCcw",
          "logic": "shift !== 0 时显示"
        },
        {
          "id": "col_vis_step",
          "name": "单体节拍柱",
          "selector": ".visualizer__column",
          "logic": "toggleStepState(i)"
        },
        {
          "id": "ind_vis_beat_group_active",
          "name": "大拍播放状态条",
          "selector": ".visualizer__beat-indicator",
          "desc": "每组大拍底部的播放态指示条；当前大拍播放时进入高亮态"
        }
      ]
    },
    {
      "area": "Main_Subdivision_Row (底部细分切换行)",
      "container": "styles['subdivision-row']",
      "path": "src/App.tsx",
      "entities": [
        {
          "id": "btn_subdiv_1_4",
          "name": "细分: 四分音符",
          "logic": "setSubdivision(1)"
        },
        {
          "id": "btn_subdiv_1_8",
          "name": "细分: 八分音符",
          "logic": "setSubdivision(2)"
        },
        {
          "id": "btn_subdiv_1_3",
          "name": "细分: 三连音",
          "logic": "setSubdivision(3)"
        },
        {
          "id": "btn_subdiv_1_16",
          "name": "细分: 十六分音符",
          "logic": "setSubdivision(4)"
        }
      ]
    },
    {
      "area": "Main_Dock_Stack (底部双 dock 容器)",
      "container": "styles['dock-section']",
      "path": "src/App.tsx",
      "contains": ["Main_Trainer_Dock", "Main_Control_Dock"],
